#!/bin/bash
# 安装/升级后刷新图标缓存，确保桌面出现「金价设置」
LOG=/var/tmp/goldticker_install.log

{
    echo "== $(date) =="
    echo "app exists: $([ -d /var/jb/Applications/GoldTickerSettings.app ] && echo yes || echo no)"
    for U in /var/jb/usr/bin/uicache /usr/bin/uicache /var/jb/usr/bin/uicache-static; do
        if [ -x "$U" ]; then
            echo "run: $U -a"
            "$U" -a
            echo "exit=$?"
        fi
    done
} >> "$LOG" 2>&1

sync

# 重建图标缓存后重启 SpringBoard，确保图标立即出现
killall -9 SpringBoard >> "$LOG" 2>&1

exit 0
