<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>金价</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>状态栏显示</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示金价</string>
			<key>key</key>
			<string>enable</string>
			<key>defaults</key>
			<string>com.aprin.goldticker</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldSpecifier</string>
			<key>label</key>
			<string>刷新间隔（秒）</string>
			<key>key</key>
			<string>interval</string>
			<key>defaults</key>
			<string>com.aprin.goldticker</string>
			<key>default</key>
			<string>5</string>
			<key>isNumeric</key>
			<true/>
			<key>alignment</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>跌破提醒</string>
			<key>footerText</key>
			<string>提醒金额填 0 或留空表示不提醒。金价跌破该值后响一次，回升到该值上方 0.2% 后重新武装。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldSpecifier</string>
			<key>label</key>
			<string>提醒金额</string>
			<key>key</key>
			<string>threshold</string>
			<key>defaults</key>
			<string>com.aprin.goldticker</string>
			<key>default</key>
			<string></string>
			<key>isNumeric</key>
			<true/>
			<key>alignment</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用提醒</string>
			<key>key</key>
			<string>alert_enable</string>
			<key>defaults</key>
			<string>com.aprin.goldticker</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>播放提醒音乐</string>
			<key>key</key>
			<string>sound_enable</string>
			<key>defaults</key>
			<string>com.aprin.goldticker</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>自定义音乐：用 Filza 把音频放到 /var/mobile/Library/GoldTicker/alert.m4a（也支持 mp3 / wav / caf / aac）。没有该文件时使用插件自带的提示音。修改后无需注销，下一轮刷新自动生效。</string>
		</dict>
	</array>
</dict>
</plist>
